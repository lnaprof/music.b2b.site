# ===== Server =====
PORT=3000

# ===== E-mail уведомления (оставьте пустым, чтобы отключить) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notify@example.com
SMTP_PASS=your-password
SMTP_FROM=SOUNDPIPE <notify@example.com>
EMAIL_TO=studio@soundpipe.audio

# ===== Telegram уведомления (оставьте пустым, чтобы отключить) =====
# Бот создается через @BotFather: https://t.me/BotFather
# chat_id — ID чата/канала, куда слать уведомления (-100... для каналов/супергрупп)
TELEGRAM_BOT_TOKEN=123456789:AAExampleToken
TELEGRAM_CHAT_ID=-1001234567890